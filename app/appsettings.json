{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "CompanyName": "SSES – Special Solutions for Environmental Services",
    "SystemName": "SSES CMMS",
    "Currency": "SAR",
    "PublicUrl": "",
    "UploadsPath": "App_Data/uploads",
    "MaxUploadMB": 10
  },

  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": true
  },
  "ConnectionStrings": {
    "SqlServer": "",
    "Sqlite": "Data Source=App_Data/sses-cmms.db"
  },

  "Auth": {
    "SessionHours": 10
  },
  "Https": {
    "Redirect": false,
    "UseHsts": false
  },
  "Pm": {
    "BackgroundGeneration": true
  },

  "Email": {
    "Enabled": false,
    "Provider": "Graph",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "SmtpHost": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SSES CMMS",
    "PickupDirectory": "",
    "DailyDigest": true,
    "DigestHour": 7
  },

  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "",
    "DemoData": false
  }
}
